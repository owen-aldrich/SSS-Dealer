{
  "name": "sss-dealer",
  "version": "2.0.0",
  "description": "SSS+Dealer — separate frontend and backend",
  "private": true,
  "workspaces": ["FrontEnd", "BackEnd"],
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node BackEnd/scripts/start.js",
    "dev": "node BackEnd/scripts/start.js --watch",
    "start:frontend": "npm start --workspace=@sss-dealer/frontend",
    "start:backend": "npm start --workspace=@sss-dealer/backend",
    "db:init": "npm run db:init --workspace=@sss-dealer/backend",
    "db:seed": "npm run db:seed --workspace=@sss-dealer/backend",
    "check": "node BackEnd/scripts/check.js",
    "test": "node --test BackEnd/tests/*.test.js"
  }
}
