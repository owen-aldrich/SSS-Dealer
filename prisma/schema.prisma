// =============================================================
// Prisma Schema — SSS+Dealer
// Database: PostgreSQL (Neon)
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
// USERS
// =============================================================
model User {
  id        Int      @id @default(autoincrement())
  fullname  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  age       Int?
  address   String?  @db.Text
  photo     String?  @db.VarChar(255)
  role      String   @default("user") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  favorites      UserFavorite[]
  compareHistory CompareHistory[]
  testDrives     TestDrive[]

  @@map("users")
}

// =============================================================
// CARS
// =============================================================
model Car {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  brand        String  @db.VarChar(50)
  type         String  @db.VarChar(50)
  price        Decimal @db.Decimal(15, 2)
  image        String  @db.VarChar(255)
  drivetrain   String  @db.VarChar(20)
  powertrain   String  @db.VarChar(30)
  transmission String  @db.VarChar(30)
  performance  String  @db.VarChar(30)
  horsepower   Int?
  torque       Int?
  topSpeed     Int?    @map("top_speed")
  accel0100    String? @map("accel_0_100") @db.VarChar(20)
  description  String? @db.Text

  // Admin fields
  year      Int      @default(2024)
  status    String   @default("available") @db.VarChar(20) // available | reserved | sold | draft
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  favorites      UserFavorite[]
  compareHistory1 CompareHistory[] @relation("CarCompare1")
  compareHistory2 CompareHistory[] @relation("CarCompare2")
  testDrives     TestDrive[]
  leads          Lead[]

  @@map("cars")
}

// =============================================================
// USER FAVORITES
// =============================================================
model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  carId     Int      @map("car_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@map("user_favorites")
}

// =============================================================
// COMPARE HISTORY
// =============================================================
model CompareHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  carId1     Int      @map("car_id_1")
  carId2     Int      @map("car_id_2")
  comparedAt DateTime @default(now()) @map("compared_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car1 Car  @relation("CarCompare1", fields: [carId1], references: [id], onDelete: Cascade)
  car2 Car  @relation("CarCompare2", fields: [carId2], references: [id], onDelete: Cascade)

  @@map("compare_history")
}

// =============================================================
// TEST DRIVES
// =============================================================
model TestDrive {
  id            Int       @id @default(autoincrement())
  userId        Int?      @map("user_id")
  carId         Int       @map("car_id")
  name          String    @db.VarChar(100)
  email         String    @db.VarChar(100)
  phone         String    @db.VarChar(30)
  preferredDate DateTime? @map("preferred_date") @db.Date
  preferredTime String?   @map("preferred_time") @db.VarChar(20)
  message       String?   @db.Text
  status        String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  createdAt     DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  car  Car   @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("test_drives")
}

// =============================================================
// LEADS — calon pembeli yang didampingi konsultan
// =============================================================
model Lead {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @db.VarChar(100)
  phone      String?  @db.VarChar(30)
  carId      Int?     @map("car_id")
  status     String   @default("new") @db.VarChar(20) // new | contacted | negotiation | closing
  consultant String?  @db.VarChar(100)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  car Car? @relation(fields: [carId], references: [id], onDelete: SetNull)

  @@map("leads")
}
