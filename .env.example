# =============================================================
# SSS+Dealer — Environment Variables (EXAMPLE)
# Salin file ini menjadi .env lalu isi nilainya
# =============================================================

# -------------------------------------------------------
# DATABASE — MySQL / TiDB Cloud
# Untuk MySQL lokal: DB_HOST=127.0.0.1, DB_PORT=3306, DB_SSL=false
# Untuk TiDB Cloud : DB_HOST=<gateway.tidbcloud.com>, DB_PORT=4000, DB_SSL=true
# -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=sss_dealer
DB_SSL=false

# -------------------------------------------------------
# JWT
# -------------------------------------------------------
JWT_SECRET=generate_random_32_bytes_hex_here
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------------------
# CLOUDINARY
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
