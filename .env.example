# SSS+Dealer Environment Variables
# Copy file ini menjadi .env dan isi nilainya:
#   copy .env.example .env

# -------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# Dapatkan dari: https://console.neon.tech → project → Connection Details
# Pilih "Pooled connection" untuk DATABASE_URL
# Pilih "Direct connection" untuk DIRECT_URL
# -------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/sss_dealer?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/sss_dealer?sslmode=require

# -------------------------------------------------------
# JWT
# Ganti dengan string random panjang (minimal 32 karakter)
# Generate contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------
JWT_SECRET=ganti_dengan_secret_random_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------------------
# CLOUDINARY (penyimpanan foto mobil & foto profil)
# Dapatkan dari: https://cloudinary.com → Dashboard → API Keys
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=nama_cloud_kamu
CLOUDINARY_API_KEY=api_key_kamu
CLOUDINARY_API_SECRET=api_secret_kamu
