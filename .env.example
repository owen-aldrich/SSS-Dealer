# =============================================================
# SSS+Dealer — Environment Variables (EXAMPLE)
# Salin file ini menjadi .env lalu isi nilainya
# =============================================================

# -------------------------------------------------------
# DATABASE — MySQL / TiDB Cloud
# Untuk MySQL lokal: DB_HOST=127.0.0.1, DB_PORT=3306, DB_SSL=false
# Untuk TiDB Cloud : DB_HOST=<gateway.tidbcloud.com>, DB_PORT=4000, DB_SSL=true
# -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=sss_dealer
DB_SSL=false

# -------------------------------------------------------
# JWT
# -------------------------------------------------------
JWT_SECRET=generate_random_32_bytes_hex_here
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
PORT=3000
NODE_ENV=development

# Frontend and backend (PORT remains the fallback for FRONTEND_PORT)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Bind all applications locally for development; use 0.0.0.0 for LAN access.
# Without HOST, frontend binds 0.0.0.0 and backend binds 127.0.0.1.
HOST=127.0.0.1

# Optional backend origin. Leave unset to use BACKEND_PORT on localhost.
# BACKEND_URL=http://127.0.0.1:3001

# The frontend proxies /api to the backend, so CORS is not needed locally.
# For direct cross-origin API access, list allowed origins separated by commas.
# CORS_ORIGINS=https://dealer.example.com
PROXY_TIMEOUT_MS=30000

# The backend has one MySQL pool.
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# -------------------------------------------------------
# CLOUDINARY
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
